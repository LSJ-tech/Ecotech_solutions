# Copiar este archivo como .env y completar los valores.
# .env está excluido del repositorio mediante .gitignore.

# Códigos secretos para registrar cuentas con rol admin y rrhh.
ECOTECH_CODIGO_ADMIN=
ECOTECH_CODIGO_RRHH=

# Ruta opcional de la base SQLite (por defecto: ecotech_solutions.db junto a main.py).
# ECOTECH_DB_PATH=

# Llave de OpenWeatherMap para el servicio de clima (Unidad 3).
OPENWEATHER_API_KEY=

# Clave Fernet para cifrar direccion, telefono y salario en la base de datos.
# Generar con: py -3 -c "import main; print(main.generar_clave_cifrado())"
# Si se pierde, los datos personales ya guardados no se pueden recuperar.
ECOTECH_CLAVE_CIFRADO=
