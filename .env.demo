# Configuracion lista para probar el sistema con la base de demostracion.
#
#     copy .env.demo .env
#     py -3 main.py
#
# Los valores de aqui sirven SOLO para la base de demostracion incluida en el
# repositorio, cuyos datos son ficticios (docs/demo/ecotech_demo.db). La clave
# con la que el equipo cifra su propia base de trabajo no esta en el
# repositorio: vive en el .env local, excluido por .gitignore.
#
# Las cuentas y contrasenas estan en docs/CREDENCIALES_PRUEBA.md.

# Codigos que se piden al CREAR una cuenta admin o rrhh (no al iniciar sesion).
ECOTECH_CODIGO_ADMIN=1234
ECOTECH_CODIGO_RRHH=12345

# Base de demostracion con datos ya cargados.
ECOTECH_DB_PATH=docs/demo/ecotech_demo.db

# Clave Fernet con la que esta cifrada esa base de demostracion.
ECOTECH_CLAVE_CIFRADO=AF5eSoRH_OxnLAuxonQlW6T7itr6z6nBEZpB8uGaxdE=

# Llave de OpenWeatherMap. Se deja vacia a proposito: es una credencial
# personal y no se publica. Sin ella la consulta de clima igual funciona, porque
# el sistema recurre a Open-Meteo, que no exige llave ni registro. Quien tenga
# una llave propia puede escribirla aqui y el sistema la usara en su lugar.
OPENWEATHER_API_KEY=
